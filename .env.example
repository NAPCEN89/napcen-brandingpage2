# Email SMTP Settings (Optional - for sending direct email via Nodemailer)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=marketing@napcen.com

# Web3Forms API Key (For contact/quote forms)
WEB3FORMS_ACCESS_KEY=
